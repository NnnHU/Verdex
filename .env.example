# Verdex environment template — copy to `.env` and fill in real values.
# `.env` is git-ignored (contains API keys); this `.env.example` is committed.
#
# Purpose: seed a Provider on first launch (when no config.json exists yet).
# After first launch, config.json is the single source of truth — edit in the UI.
#
# NOTE: fields MUST start with `VITE_` so Vite exposes them to the frontend
# via `import.meta.env`. Non-VITE-prefixed vars are NOT readable in the app.

# === Provider seed (primary — fast, general-purpose model) ===
VITE_VERDEX_PROVIDER_BASE_URL=https://api.siliconflow.cn/v1
VITE_VERDEX_PROVIDER_API_KEY=sk-your-api-key-here
VITE_VERDEX_PROVIDER_MODEL=deepseek-ai/DeepSeek-V3
VITE_VERDEX_PROVIDER_NAME=DeepSeek V3 (SiliconFlow)
VITE_VERDEX_PROVIDER_PROTOCOL=openai

# === Second provider (optional — for multi-model analysis / document_analysis task) ===
# Leave commented out if you only have one model.
VITE_VERDEX_PROVIDER2_BASE_URL=https://api.siliconflow.cn/v1
VITE_VERDEX_PROVIDER2_API_KEY=sk-your-api-key-here
VITE_VERDEX_PROVIDER2_MODEL=deepseek-ai/DeepSeek-R1
VITE_VERDEX_PROVIDER2_NAME=DeepSeek R1 (SiliconFlow)
VITE_VERDEX_PROVIDER2_PROTOCOL=openai

# === Memory tuning (Stage 1a: sliding window) ===
# Recent turns kept as raw user/assistant messages (suggested 6-10).
VITE_VERDEX_MEMORY_RECENT_TURNS=8
# History trimmed when (history + prompt) chars exceed maxContextChars * trimRatio.
VITE_VERDEX_MEMORY_TRIM_RATIO=0.75
# Conservative context cap in chars (~4 chars/token).
VITE_VERDEX_PROVIDER_MAX_CONTEXT_CHARS=200000
# Print memory trim logs to console (dev only).
VITE_VERDEX_DEBUG_MEMORY=false
# Default per-request timeout (ms).
VITE_VERDEX_REQUEST_TIMEOUT_MS=60000

# === Map-Reduce (Stage 4) ===
# Force mode: auto (adaptive) | always | never. Use "always"/"never" only in
# exceptional cases — auto is the recommended default.
# auto (单次优先): 只在 总字符 > TRIGGER_RATIO × maxContextChars 或 单份超大时触发.
VITE_VERDEX_MAPREDUCE_FORCE=auto
# Map-Reduce 触发阈值: 总字符占 maxContextChars 的比例. 0.75 = 15万字符.
VITE_VERDEX_MAPREDUCE_TRIGGER_RATIO=0.75
# (保留, auto 不再用份数触发)
VITE_VERDEX_MAPREDUCE_DOC_THRESHOLD=4

# === Hierarchical summary memory (Stage 1b) ===
# Model used to summarize early conversation history. Empty = use the session's
# first judge model. Set to a faster/cheaper model to speed up summarization.
VITE_VERDEX_SUMMARY_MODEL=
# How many new turns beyond the recent window must accumulate before triggering
# a fresh summary. 4 = re-summarize after every 4 new turns past the window.
VITE_VERDEX_SUMMARY_INTERVAL=4
